+// setQueuedTracks replaces the tracks added to the queue (POST
+// /player/queue/set). Unlike setQueue it gives the snapshot no next-tracks
+// hint -- set_queue's hint is Spotify's whole upcoming list, this one only
+// the queued tracks -- so the context's tracks still follow them.
+func (p *AppPlayer) setQueuedTracks(queued []*connectpb.ContextTrack) {
+	if p.state.tracks == nil {
+		p.app.log.Warnf("cannot set queue without a context")
+		return
+	}
+
+	p.listJob("set queued tracks", classMutate, nil,
+		func(_ context.Context, list *tracks.List) error {
+			list.SetQueue(nil, queued)
+			return nil
+		},
+		func(p *AppPlayer, snap *tracks.Snapshot, err error) {
+			if err != nil {
+				p.app.log.WithError(err).Warn("failed setting queued tracks")
+				return
+			}
+
+			p.publishUpcoming(snap)
+			p.invalidateUpcoming()
+			p.schedulePrefetchNext()
+			p.updateState()
+		})
+}
